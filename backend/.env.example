DB_TYPE=sqljs
DB_SQLJS_LOCATION=dev.sqlite
BACKEND_PORT=5108
# Production requires a random secret (>=32 characters), never commit the real value.
JWT_SECRET=
# Production defaults to loopback. Expose the UI through an authenticated HTTPS proxy.
BACKEND_HOST=127.0.0.1
CORS_ORIGINS=
ENABLE_SWAGGER=false
FRONTEND_PORT=5278
REQUEST_BODY_LIMIT=10mb
SEO_TOOL_PORT=5388
FTP_TOOL_PORT=5389
MANAGED_SITES_DIR=../managed-sites

# Central backend database backup directory.
BACKEND_DB_BACKUP_DIR=
# Resource quarantine outside all HTTP roots. Example on BaoTa: /www/backup/pboot-resource-quarantine
RESOURCE_QUARANTINE_ROOT=

# Optional server-side PDF browser override (otherwise use Playwright's installed Chromium).
BROCHURE_PDF_EXECUTABLE_PATH=

# Optional translation model keys.
OPENAI_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Shared YouTube Data API key. Channel IDs are configured per website.
YOUTUBE_API_KEY=
# SEO worker: independent process, all sites disabled until explicitly enabled.
# Generate a random value of at least 32 characters; never commit real tokens.
SEO_WORKER_TOKEN=
SEO_WORKER_API_URL=http://127.0.0.1:5108
# DeepSeek research reuses DEEPSEEK_API_KEY above (or the existing server AI config).
# Search provider, research model, writing model and request/output limits are per site.
# Optional licensed Brave Search API key. Confirm result-retention rights before enabling.
# Keep server-side; keyword search defaults off per website.
BRAVE_SEARCH_API_KEY=
